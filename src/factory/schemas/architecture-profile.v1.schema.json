{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory.profile/v1",
  "title": "Architecture profile v1",
  "description": "The accepted ADRs (id and revision) one repository must follow, and the CI checks that enforce them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "repository", "adrs"],
  "properties": {
    "schemaVersion": {"const": "factory.profile/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "revision": {"type": "integer", "minimum": 1},
    "repository": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "adrs": {
      "description": "May be empty: a deliberately empty profile is an explicit, visible choice.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"},
          "revision": {"type": "integer", "minimum": 1}
        }
      }
    },
    "enforcedBy": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check"],
        "properties": {
          "check": {"type": "string", "minLength": 1}
        }
      }
    },
    "manualOnly": {
      "description": "ADR constraint ids that no automated check enforces.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
