{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory.evidence-snapshot/v1",
  "title": "Evidence snapshot v1",
  "description": "Observed facts that the planner evaluates. A fact that is absent means UNKNOWN, never PASS. In this version the only supported provenance is 'simulated': no collector exists yet, so no fact in a snapshot is authenticated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "provenance", "approvals", "repositories"],
  "properties": {
    "schemaVersion": {"const": "factory.evidence-snapshot/v1"},
    "project": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["simulated"]},
        "note": {"type": "string"}
      }
    },
    "observedAt": {
      "description": "Copied to the plan output unchanged. Never generated by the planner.",
      "type": "string"
    },
    "approvals": {
      "description": "One entry per approved-or-not artifact (task, profile or ADR file), keyed by project-relative path.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "approved"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "approved": {"type": "boolean"},
          "mergedBy": {"type": ["string", "null"]},
          "pullRequest": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    },
    "repositories": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {"$ref": "#/$defs/repositoryFacts"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
    "repositoryFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "integrationHead": {"$ref": "#/$defs/commitSha"},
        "branches": {
          "description": "Pull requests found for each queried head branch. A listed branch with an empty list means no PR exists; an unlisted branch is UNKNOWN.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pullRequests"],
            "properties": {
              "pullRequests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["number", "state", "baseBranch"],
                  "properties": {
                    "number": {"type": "integer", "minimum": 1},
                    "state": {"enum": ["open", "closed", "merged"]},
                    "baseBranch": {"type": "string", "minLength": 1},
                    "mergeCommitSha": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/commitSha"}]}
                  }
                }
              }
            }
          }
        },
        "commits": {
          "type": "object",
          "propertyNames": {"pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reachableFromIntegrationHead": {"type": "boolean"},
              "mergedPullRequests": {
                "description": "Numbers of merged PRs whose merge commit SHA equals this commit.",
                "type": "array",
                "items": {"type": "integer", "minimum": 1}
              },
              "checkRuns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "app", "event", "headBranch", "workflowPath", "status", "conclusion", "attempt"],
                  "properties": {
                    "name": {"type": "string"},
                    "app": {"type": "string"},
                    "event": {"type": "string"},
                    "headBranch": {"type": "string"},
                    "workflowPath": {"type": "string"},
                    "status": {"enum": ["queued", "in_progress", "completed"]},
                    "conclusion": {"enum": [null, "success", "failure", "neutral", "cancelled", "skipped", "timed_out", "action_required", "stale", "startup_failure"]},
                    "attempt": {"type": "integer", "minimum": 1}
                  }
                }
              },
              "outputs": {
                "description": "Declared outputs observed at this commit, keyed by manifest output id.",
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["present"],
                  "properties": {
                    "present": {"type": "boolean"},
                    "version": {"type": ["string", "null"]}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
