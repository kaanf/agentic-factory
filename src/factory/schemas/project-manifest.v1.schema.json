{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory.project/v1",
  "title": "Factory project manifest v1",
  "description": "Describes one project: its repositories, branch conventions, required checks, declared outputs and architecture profiles. Everything project-specific lives here, never in Factory Core source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "approvers", "planningRepository", "repositories", "architecture", "dispatch"],
  "properties": {
    "schemaVersion": {"const": "factory.project/v1"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "approvers": {
      "description": "GitHub logins whose merges into the planning repository's integration branch are recorded as approvals. A login identifies a credential, not a person, so these approvals stay unverifiable until agent and human credentials are separated. Listing a login here grants nothing by itself.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"}
    },
    "planningRepository": {
      "description": "Repository id that holds this manifest, the task files, profiles and ADRs.",
      "$ref": "#/$defs/slug"
    },
    "planningDirectory": {
      "description": "Path of the project directory inside the planning repository, used to find approval records. Omit when the project directory is the repository root.",
      "$ref": "#/$defs/relativePath"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repository"}
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adrDirectory", "profiles"],
      "properties": {
        "adrDirectory": {"$ref": "#/$defs/relativePath"},
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "repository", "path"],
            "properties": {
              "id": {"$ref": "#/$defs/slug"},
              "repository": {"$ref": "#/$defs/slug"},
              "path": {"$ref": "#/$defs/relativePath"}
            }
          }
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Global switch for agent dispatch. Defaults to false. This Factory Core version has no dispatch capability and rejects true.",
          "type": "boolean",
          "default": false
        },
        "archon": {
          "description": "The Archon release this project's dispatch configuration was validated against. Preflight refuses any other installed version.",
          "type": "object",
          "additionalProperties": false,
          "required": ["validatedVersion"],
          "properties": {
            "validatedVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"}
          }
        },
        "workflows": {
          "description": "Archon workflows tasks may name. A workflow must also be supported by Factory Core and not denied by it; this list cannot widen Factory Core's own denylist.",
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "allowed"],
          "properties": {
            "default": {"$ref": "#/$defs/name"},
            "allowed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
            "forbidden": {
              "description": "Additional workflows to deny. Added to Factory Core's built-in denylist, never replacing it.",
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/name"}
            }
          }
        },
        "providers": {
          "description": "Coding-agent providers, each mapped to the Archon assistant that runs it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "available"],
          "properties": {
            "default": {"$ref": "#/$defs/name"},
            "available": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {"$ref": "#/$defs/name"},
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["archonAssistant"],
                "properties": {"archonAssistant": {"$ref": "#/$defs/name"}}
              }
            }
          }
        },
        "maxAttemptsPerTaskRevision": {
          "description": "Dispatch attempts allowed per task revision before a human must revise the task.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 2
        }
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 100},
    "relativePath": {
      "description": "POSIX path relative to the project directory. Absolute paths and '..' segments are rejected.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\x00]+$"
    },
    "branchName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9._/-]+(?<!/)(?<!\\.lock)$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "github", "branches", "requiredChecks"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "github": {
          "description": "GitHub repository as owner/name.",
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$"
        },
        "branches": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integration", "release", "featurePrefix"],
          "properties": {
            "integration": {"$ref": "#/$defs/branchName"},
            "release": {"$ref": "#/$defs/branchName"},
            "featurePrefix": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9._/-]+$"
            }
          }
        },
        "requiredChecks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integration"],
          "properties": {
            "integration": {
              "description": "Checks that must succeed on push CI for an exact integration-branch commit before it counts as validated.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "workflowPath"],
                "properties": {
                  "name": {"type": "string", "minLength": 1, "maxLength": 200},
                  "workflowPath": {"$ref": "#/$defs/relativePath"},
                  "app": {
                    "description": "Slug of the GitHub App that must have reported the check.",
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "default": "github-actions"
                  }
                }
              }
            }
          }
        },
        "outputs": {
          "description": "Files this repository publishes for other repositories, such as an API contract.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "versionPointer"],
            "properties": {
              "id": {"$ref": "#/$defs/slug"},
              "path": {"$ref": "#/$defs/relativePath"},
              "versionPointer": {
                "description": "JSON Pointer to the version field inside the output file.",
                "type": "string",
                "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
              }
            }
          }
        }
      }
    }
  }
}
